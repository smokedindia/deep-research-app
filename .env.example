# Ollama Configuration
# Set this if your Ollama server requires bearer token authentication
OLLAMA_BEARER_TOKEN=your_bearer_token_here

# Ollama Host (default: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434

# Ollama Model (default: llama3.2:3b)
OLLAMA_MODEL=llama3.2:3b

# Ollama Temperature (default: 0.7)
OLLAMA_TEMPERATURE=0.7

# Ollama Timeout in milliseconds (default: 120000)
OLLAMA_TIMEOUT=120000

# Research Configuration
# Maximum depth to explore (default: 3)
RESEARCH_MAX_DEPTH=3

# Maximum pages per level (default: 3)
RESEARCH_MAX_PAGES=3

# Page timeout in milliseconds (default: 30000)
RESEARCH_PAGE_TIMEOUT=30000

# Scroll delay in milliseconds (default: 2000)
RESEARCH_SCROLL_DELAY=2000

# Maximum total research time in milliseconds (default: 600000 = 10 minutes)
RESEARCH_MAX_TIME=600000

# Search engine URL (default: https://www.google.com/search?q=)
RESEARCH_SEARCH_ENGINE=https://www.google.com/search?q=
